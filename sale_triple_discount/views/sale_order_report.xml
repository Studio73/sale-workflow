<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document_triple_discount"
        inherit_id="sm_product_assortment.report_saleorder_document_inh_sm_product_assortment"
    >
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <t t-set="display_discount" t-value="False" />
            <t
                t-set="display_discount1"
                t-value="any(l.discount1 for l in doc.order_line)"
            />
            <t
                t-set="display_discount2"
                t-value="any(l.discount2 for l in doc.order_line)"
            />
            <t
                t-set="display_discount3"
                t-value="any(l.discount3 for l in doc.order_line)"
            />
        </xpath>
        <xpath
            expr="//table[hasclass('o_main_table')]/thead/tr/td[normalize-space(.)='Pares']"
            position="after"
        >
            <td
                t-if="display_discount1"
                class="text-center"
                groups="sale.group_discount_per_so_line"
            >
                Disc. 1 (%)
            </td>
            <td
                t-if="display_discount2"
                class="text-center"
                groups="sale.group_discount_per_so_line"
            >
                Disc. 2 (%)
            </td>
            <td
                t-if="display_discount3"
                class="text-center"
                groups="sale.group_discount_per_so_line"
            >
                Disc. 3 (%)
            </td>
        </xpath>
        <xpath
            expr="//table[hasclass('o_main_table')]/tbody/t[@t-foreach='report_rows']/tr/td[span[@t-esc=&quot;row['pairs']&quot;]]"
            position="after"
        >
            <td
                t-if="display_discount1"
                class="text-center"
                groups="sale.group_discount_per_so_line"
            >
                <span t-esc="row.get('discount1', 0)" />
            </td>
            <td
                t-if="display_discount2"
                class="text-center"
                groups="sale.group_discount_per_so_line"
            >
                <span t-esc="row.get('discount2', 0)" />
            </td>
            <td
                t-if="display_discount3"
                class="text-center"
                groups="sale.group_discount_per_so_line"
            >
                <span t-esc="row.get('discount3', 0)" />
            </td>
        </xpath>
        <xpath
            expr="//table[hasclass('o_main_table')]/tbody/tr[contains(@style, 'font-size: 12px')]/td[.//span[@t-esc='par_total']]"
            position="after"
        >
            <td
                t-if="display_discount1"
                style="border-top: 2px solid black;"
                groups="sale.group_discount_per_so_line"
            />
            <td
                t-if="display_discount2"
                style="border-top: 2px solid black;"
                groups="sale.group_discount_per_so_line"
            />
            <td
                t-if="display_discount3"
                style="border-top: 2px solid black;"
                groups="sale.group_discount_per_so_line"
            />
        </xpath>
    </template>
</odoo>
